# Get your API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxx

# --- Optional hardening (recommended for any public/shared deployment) ---

# Shared secret that gates the /api/discuss endpoint. When APP_SECRET is set, the
# server requires the same value in the "x-app-secret" request header. The browser
# client sends NEXT_PUBLIC_APP_SECRET automatically, so set BOTH to the same value.
# NOTE: NEXT_PUBLIC_* is embedded in the client bundle, so this is a *soft* gate that
# stops casual/bot abuse of the raw API. For strong auth, put the app behind Vercel
# Deployment Protection (password/SSO) or your own auth proxy.
# APP_SECRET=choose-a-long-random-string
# NEXT_PUBLIC_APP_SECRET=choose-a-long-random-string

# Rate-limit tuning (defaults shown). Counters are in-memory per serverless instance;
# for hard multi-instance limits, back them with an external store (Upstash/Redis).
# RATE_LIMIT_MAX=8             # requests per IP per window
# RATE_LIMIT_WINDOW_MS=60000   # window length in ms
# RATE_LIMIT_CONCURRENCY=2     # concurrent discussions per IP
# GLOBAL_MAX_CONCURRENCY=12    # concurrent discussions across all IPs

# Sent as the HTTP-Referer header to OpenRouter (optional)
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
